<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Alias porque o .NET 10 gera um Program público em cada executável web; sem ele, Program seria ambíguo. -->
    <ProjectReference Include="../../src/Services/Identity/Ouroboros.Identity.Api/Ouroboros.Identity.Api.csproj" Aliases="identityapi" OutputItemType="ArchitectureAssembly" />
  </ItemGroup>
  <!--
    As regras de dependência analisam todo projeto de src, inclusive serviços e executáveis novos. O curinga
    garante que cada um seja compilado antes dos testes, sem referenciá-lo (ReferenceOutputAssembly=false).
    A API de Identity acima já é referenciada e fica fora do curinga.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/**/*.csproj"
                      Exclude="../../src/Services/Identity/Ouroboros.Identity.Api/Ouroboros.Identity.Api.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="ArchitectureAssembly" />
  </ItemGroup>
  <!-- Lista, ao lado dos testes, o assembly compilado de cada projeto de src (OutputItemType acima). -->
  <Target Name="WriteArchitectureAssemblyManifest" AfterTargets="CopyFilesToOutputDirectory">
    <WriteLinesToFile File="$(OutDir)architecture-assemblies.txt" Lines="@(ArchitectureAssembly->'%(FullPath)')" Overwrite="true" />
  </Target>
</Project>
