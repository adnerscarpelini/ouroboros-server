# Copie para .env (fora do Git) e troque TODAS as senhas. Usado pelo compose.yaml.

# Versão e revisão imutáveis das imagens dos serviços (<APP_VERSION>-<SOURCE_REVISION>).
APP_VERSION=0.1.0
SOURCE_REVISION=local
IMAGE_TAG=0.1.0-local

# Portas de loopback e diretórios externos de chaves por serviço (fora de qualquer checkout Git).
# Gere os diretórios com: pwsh -NoProfile -File scripts/messaging/new-compose-keys.ps1 -Directory <caminho-externo>
IDENTITY_PUBLIC_PORT=5141
NOTIFICATIONS_HEALTH_PORT=5143
EXTERNAL_GATEWAY_PORT=5151
ADMIN_GATEWAY_PORT=5152
# O IP exato do gateway deve pertencer à subnet; ajuste ambos se houver sobreposição local.
GATEWAY_NETWORK_SUBNET=172.30.230.0/24
EXTERNAL_GATEWAY_IP=172.30.230.10
IDENTITY_KEYS_DIR=/caminho/externo/chaves/identity
NOTIFICATIONS_KEYS_DIR=/caminho/externo/chaves/notifications

# Credencial ADMINISTRATIVA da instância PostgreSQL (superusuário). Só o container do PostgreSQL e o
# comando de provisionamento a usam; APIs e workers nunca recebem estes valores.
POSTGRES_DB=ouroboros
POSTGRES_USER=ouroboros
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Credenciais por serviço, criadas por: docker compose --profile provision run --rm provision-databases
# Runtime (DML, sem DDL) é a única que a API/worker do serviço recebe; migration (DDL) só é usada no
# comando explícito de migrations. Use senhas distintas; cada uma vale somente para o banco do próprio serviço.
IDENTITY_RUNTIME_PASSWORD=troque-esta-senha-identity-runtime
IDENTITY_MIGRATION_PASSWORD=troque-esta-senha-identity-migration
NOTIFICATIONS_RUNTIME_PASSWORD=troque-esta-senha-notifications-runtime
NOTIFICATIONS_MIGRATION_PASSWORD=troque-esta-senha-notifications-migration

# RabbitMQ: administrador só para provisionamento/operador, nunca entregue a serviços.
# Use quatro senhas distintas, geradas aleatoriamente, com pelo menos 32 caracteres.
RABBITMQ_ADMIN_USER=broker_operator
RABBITMQ_ADMIN_PASSWORD=troque-por-senha-aleatoria-distinta-admin
IDENTITY_BROKER_PASSWORD=troque-por-senha-aleatoria-distinta-identity
NOTIFICATIONS_BROKER_PASSWORD=troque-por-senha-aleatoria-distinta-consumer
NOTIFICATIONS_FAILURES_BROKER_PASSWORD=troque-por-senha-aleatoria-distinta-failures
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
