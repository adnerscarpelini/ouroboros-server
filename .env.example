# Copie para .env (fora do Git) e troque TODAS as senhas. Usado pelo compose.yaml.

# Credencial ADMINISTRATIVA da instância PostgreSQL (superusuário). Só o container do PostgreSQL e o
# comando de provisionamento a usam; APIs e workers nunca recebem estes valores.
POSTGRES_DB=ouroboros
POSTGRES_USER=ouroboros
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Credenciais por serviço, criadas por: docker compose --profile provision run --rm provision-databases
# Runtime (DML, sem DDL) é a única que a API/worker do serviço recebe; migration (DDL) só é usada no
# comando explícito de migrations. Use senhas distintas; cada uma vale somente para o banco do próprio serviço.
IDENTITY_RUNTIME_PASSWORD=troque-esta-senha-identity-runtime
IDENTITY_MIGRATION_PASSWORD=troque-esta-senha-identity-migration
NOTIFICATIONS_RUNTIME_PASSWORD=troque-esta-senha-notifications-runtime
NOTIFICATIONS_MIGRATION_PASSWORD=troque-esta-senha-notifications-migration
