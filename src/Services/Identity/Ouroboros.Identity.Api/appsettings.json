{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "Listeners": {
      "Public": { "Urls": [ "http://localhost:5141" ] },
      "Admin": { "Urls": [ "http://localhost:5142" ], "AllowNonLoopback": false }
    },
    "RateLimiting": {
      "Policies": {
        "identity-keys": { "PermitLimit": 60, "Window": "00:01:00" },
        "identity-login": { "PermitLimit": 10, "Window": "00:01:00" },
        "identity-refresh": { "PermitLimit": 30, "Window": "00:01:00" },
        "identity-logout": { "PermitLimit": 30, "Window": "00:01:00" },
        "identity-registration": { "PermitLimit": 5, "Window": "00:01:00" },
        "identity-registration-completion": { "PermitLimit": 10, "Window": "00:01:00" },
        "identity-password-reset": { "PermitLimit": 5, "Window": "00:01:00" },
        "identity-password-reset-completion": { "PermitLimit": 10, "Window": "00:01:00" },
        "identity-password-change": { "PermitLimit": 10, "Window": "00:01:00" },
        "identity-parameter-write": { "PermitLimit": 10, "Window": "00:01:00" },
        "identity-admin-actions": { "PermitLimit": 10, "Window": "00:01:00" },
        "identity-client-validation": { "PermitLimit": 120, "Window": "00:01:00" }
      }
    }
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "ouroboros",
      "Audience": "ouroboros-api",
      "AdminAudience": "ouroboros-backoffice",
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "7.00:00:00"
    }
  }
}
