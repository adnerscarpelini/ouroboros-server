@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider Theme="OuroborosTheme.Theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="o-app">
    <a class="o-skip-link" href="#conteudo">Pular para o conteúdo</a>
    <TopNav IsDarkMode="_isDarkMode" OnToggleTheme="ToggleThemeAsync" />
    <main id="conteudo" class="o-main" tabindex="-1">
        @Body
    </main>
    <SiteFooter />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Escuro é o padrão da marca; o tema real vem do navegador assim que o circuito interativo inicia.
    private bool _isDarkMode = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var theme = await JS.InvokeAsync<string>("ouroboros.theme.get");
        var isDark = theme != "light";
        if (isDark != _isDarkMode)
        {
            _isDarkMode = isDark;
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("ouroboros.theme.set", _isDarkMode ? "dark" : "light");
    }
}
