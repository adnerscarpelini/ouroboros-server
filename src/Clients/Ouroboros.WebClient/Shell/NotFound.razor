@page "/not-found"

<PageTitle>Página não encontrada · Ouroboros</PageTitle>

<section class="o-status" aria-labelledby="status-title">
    <div class="o-container">
        <p class="o-status__code o-gradient-text" aria-hidden="true">404</p>
        <h1 id="status-title" class="o-status__title">Página não encontrada</h1>
        <p class="o-status__text">O endereço acessado não existe ou mudou de lugar.</p>
        <a class="o-btn o-btn--primary" href="">
            <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" />
            Voltar ao início
        </a>
    </div>
</section>
