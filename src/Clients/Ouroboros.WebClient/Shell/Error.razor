@page "/error"
@using System.Diagnostics

<PageTitle>Erro · Ouroboros</PageTitle>

<section class="o-status" aria-labelledby="status-title">
    <div class="o-container">
        <h1 id="status-title" class="o-status__title">Não foi possível concluir a solicitação</h1>
        <p class="o-status__text">Ocorreu um erro inesperado. Tente novamente em instantes.</p>
        @if (!string.IsNullOrEmpty(TraceId))
        {
            <p class="o-status__text">Identificador para suporte: <code class="o-mono">@TraceId</code></p>
        }
        <a class="o-btn o-btn--ghost" href="">Voltar ao início</a>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [PersistentState]
    public string? TraceId { get; set; }

    protected override void OnInitialized() =>
        TraceId ??= Activity.Current?.TraceId.ToString() ?? HttpContext?.TraceIdentifier;
}
