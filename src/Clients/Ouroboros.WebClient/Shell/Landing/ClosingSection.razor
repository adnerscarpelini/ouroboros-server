<section class="o-section" aria-labelledby="explorar-title">
    <div class="o-container">
        <div class="o-cta" data-reveal>
            <div>
                <h2 id="explorar-title" class="o-cta__title">Explore o código, as decisões e os testes</h2>
                <p class="o-cta__text">
                    Cada entrega nasce numa issue, passa por QA e chega à main por pull request, com a decisão registrada
                    na documentação.
                </p>
            </div>
            <div class="o-cta__actions">
                <a class="o-btn o-btn--primary" href="@ProjectLinks.Repository" target="_blank" rel="noopener noreferrer">
                    <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small" />
                    Abrir no GitHub
                </a>
                <a class="o-btn o-btn--ghost" href="@ProjectLinks.Documentation" target="_blank" rel="noopener noreferrer">
                    Ler a documentação
                </a>
            </div>
        </div>
    </div>
</section>
